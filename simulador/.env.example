# Copiar a ".env" (mismo directorio) y completar. No se commitea.

# ---------------------------------------------------------------------------
# Transporte HTTP (canal de respaldo, siempre disponible)
# ---------------------------------------------------------------------------
# Sin protocolo final "/" y SIN el "/api" final (se agrega en el codigo).
BACKEND_URL=https://CAMBIAR-ANTES-DE-USAR.duckdns.org

# Debe coincidir con IOT_API_KEY del .env del backend.
IOT_API_KEY=CAMBIAR-POR-LA-CLAVE-REAL

# ---------------------------------------------------------------------------
# Transporte MQTT (canal preferido, D-026)
# ---------------------------------------------------------------------------
# Si MQTT_URL está definida, el simulador usa MQTT por defecto.
# Broker de produccion: mqtts://terravid-api.duckdns.org:8883
# Broker local:         mqtt://localhost:1883
MQTT_URL=mqtts://CAMBIAR-ANTES-DE-USAR.duckdns.org:8883

# Ruta al certificado CA en PEM (opcional). Sin él, se usan las CA del sistema
# (Let's Encrypt con ISRG Root X1 funciona sin configuración adicional).
# MQTT_CA_CERT=/ruta/a/isrg-root-x1.pem

# ---------------------------------------------------------------------------
# Sensores — codigos y credenciales MQTT
# ---------------------------------------------------------------------------
# Los codigos deben coincidir con los sensores dados de alta en el backend
# (Propietario -> Sensores). Las credenciales MQTT se generan en la Web:
# Telemetria → sensor → "Credencial MQTT". La password se ve solo una vez.

# --- Obligatorios: el simulador siempre los envía ---
CODIGO_SENSOR_TEMPERATURA=NODO01-TEMP
MQTT_USUARIO_TEMPERATURA=NODO01-TEMP
MQTT_PASSWORD_TEMPERATURA=CAMBIAR-POR-LA-PASSWORD-GENERADA

CODIGO_SENSOR_HUMEDAD_AMBIENTE=NODO01-HUM-AMB
MQTT_USUARIO_HUMEDAD_AMBIENTE=NODO01-HUM-AMB
MQTT_PASSWORD_HUMEDAD_AMBIENTE=CAMBIAR-POR-LA-PASSWORD-GENERADA

CODIGO_SENSOR_HUMEDAD_SUELO=NODO01-HUM-SUELO
MQTT_USUARIO_HUMEDAD_SUELO=NODO01-HUM-SUELO
MQTT_PASSWORD_HUMEDAD_SUELO=CAMBIAR-POR-LA-PASSWORD-GENERADA

# --- Opcionales: dejar en blanco o comentar si no están dados de alta ---
# CODIGO_SENSOR_PLUVIOMETRO=NODO01-PLUVIO
# MQTT_USUARIO_PLUVIOMETRO=NODO01-PLUVIO
# MQTT_PASSWORD_PLUVIOMETRO=CAMBIAR-POR-LA-PASSWORD-GENERADA

# CODIGO_SENSOR_RADIACION_SOLAR=NODO01-RAD
# MQTT_USUARIO_RADIACION_SOLAR=NODO01-RAD
# MQTT_PASSWORD_RADIACION_SOLAR=CAMBIAR-POR-LA-PASSWORD-GENERADA

# CODIGO_SENSOR_VIENTO=NODO01-VIENTO
# MQTT_USUARIO_VIENTO=NODO01-VIENTO
# MQTT_PASSWORD_VIENTO=CAMBIAR-POR-LA-PASSWORD-GENERADA

# ---------------------------------------------------------------------------
# Intervalo entre tandas de lecturas simuladas
# ---------------------------------------------------------------------------
INTERVALO_SEGUNDOS=30
